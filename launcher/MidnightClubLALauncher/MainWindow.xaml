<Window x:Class="MidnightClubLA.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Midnight Club LA Recompiled"
        Height="620" Width="880"
        MinHeight="620" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="#0B0C0E"
        Icon="pack://application:,,,/icon.ico">

    <Window.Resources>
        <!-- Monochromatic Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0C0E" />
        <SolidColorBrush x:Key="BgHeader" Color="#111216" />
        <SolidColorBrush x:Key="BgCard" Color="#15161C" />
        <SolidColorBrush x:Key="BgCardHover" Color="#1C1E25" />
        <SolidColorBrush x:Key="BorderMuted" Color="#262832" />
        <SolidColorBrush x:Key="BorderFocus" Color="#505466" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F1F5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8E92A4" />
        <SolidColorBrush x:Key="TextDim" Color="#5A5D70" />
        <SolidColorBrush x:Key="AccentWhite" Color="#FFFFFF" />

        <!-- Monochromatic CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,4,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RootBorder" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Custom Check Indicator Box -->
                                <Border x:Name="Box" Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="4" Background="#1B1C23" BorderBrush="{StaticResource BorderFocus}" BorderThickness="1">
                                    <Path x:Name="CheckMark" Data="M 3 8 L 7 12 L 14 4" Stroke="#0B0C0E" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                </Border>

                                <!-- Label & Description -->
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#3D4050" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BgCardHover}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource BorderFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monochromatic RadioButton (Segmented Card) Style -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RadioBorder" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="DotOuter" Width="16" Height="16" CornerRadius="8" BorderBrush="{StaticResource BorderFocus}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="DotInner" Width="8" Height="8" Fill="#FFFFFF" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter TargetName="RadioBorder" Property="Background" Value="#1C1E26" />
                                <Setter TargetName="DotOuter" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter TargetName="DotInner" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource BgCardHover}" />
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="{StaticResource BorderFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smooth Tab Item Style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" Padding="20,10" Margin="0,0,4,0" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Primary Button Style -->
        <Style x:Key="PlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0B0C0E" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#D6D8E4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#B4B6C2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#262832" />
                                <Setter Property="Foreground" Value="#5A5D70" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monochromatic Secondary Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="{StaticResource BgCardHover}" />
                                <Setter TargetName="SecBorder" Property="BorderBrush" Value="{StaticResource BorderFocus}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="#252733" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SecBorder" Property="Background" Value="#121318" />
                                <Setter TargetName="SecBorder" Property="BorderBrush" Value="#1E2028" />
                                <Setter Property="Foreground" Value="#555869" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button (Close/Minimize) -->
        <Style x:Key="WindowCtrlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Wb" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wb" Property="Background" Value="#22242E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Window Frame -->
    <Border BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" Background="{StaticResource BgDark}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />  <!-- Custom Title Bar -->
                <RowDefinition Height="110" /> <!-- Hero / Logo Area -->
                <RowDefinition Height="46" />  <!-- Segmented Steps Navigation -->
                <RowDefinition Height="*" />   <!-- Active Stage Content -->
                <RowDefinition Height="34" />  <!-- Footer Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Top Bar: Drag Window & Control Buttons -->
            <Grid Grid.Row="0" Background="{StaticResource BgHeader}" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="MIDNIGHT CLUB: LOS ANGELES" FontSize="11" FontWeight="Bold" Foreground="#8E92A4" VerticalAlignment="Center" />
                    <Border Background="#1C1E26" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="RECOMPILED" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Style="{StaticResource WindowCtrlBtn}" Click="MinimizeButton_Click" />
                    <Button Content="✕" Style="{StaticResource WindowCtrlBtn}" Click="ExitButton_Click" />
                </StackPanel>
            </Grid>

            <!-- 2. Hero Logo Banner Area -->
            <Grid Grid.Row="1" Background="#0F1014">
                <Border BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,0,0,1">
                    <Image x:Name="CoverImage"
                           Height="80"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>

            <!-- 3. Navigation Bar (Segmented Steps) -->
            <Border Grid.Row="2" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="0,0,0,1">
                <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" Margin="16,0" SelectionChanged="MainTabControl_SelectionChanged">
                    <TabItem x:Name="TabJogar" Header="1. JOGAR" />
                    <TabItem x:Name="TabGraficos" Header="2. GRÁFICOS &amp; FLAGS" />
                    <TabItem x:Name="TabInstalacao" Header="3. INSTALAÇÃO (ISO)" />
                    <TabItem x:Name="TabSobre" Header="4. SOBRE" />
                </TabControl>
            </Border>

            <!-- 4. Active Stage Body -->
            <Grid Grid.Row="3" Margin="24,18">

                <!-- STAGE 1: JOGAR -->
                <Grid x:Name="PanelJogar" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Status Pill -->
                    <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#4CAF50" Margin="0,0,10,0" />
                                <TextBlock x:Name="PlayStatusText" Text="Verificando integridade dos arquivos..." FontSize="13" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock x:Name="PlayNoteText" Text="" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Quick Options Box -->
                    <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="PREFERÊNCIAS RÁPIDAS DE INICIALIZAÇÃO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Resolution Quick Select -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Resolução de Renderização" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Radio1x" Content="1080p" GroupName="QuickRes" />
                                        <RadioButton x:Name="Radio2x" Content="1440p (2K)" GroupName="QuickRes" IsChecked="True" />
                                        <RadioButton x:Name="Radio3x" Content="4K" GroupName="QuickRes" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- FPS Quick Select -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Taxa de Quadros" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RadioFps60" Content="60 FPS (Estável)" GroupName="QuickFps" IsChecked="True" />
                                        <RadioButton x:Name="RadioFps120" Content="Desbloqueado" GroupName="QuickFps" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Big PLAY Action -->
                    <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Pronto para acelerar nas noites de Los Angeles" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="Execução direta em DirectX 12 nativo x86_64 sem emulação pesada." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Button x:Name="PlayButton"
                                Grid.Column="1"
                                Content="JOGAR  ►"
                                Style="{StaticResource PlayButtonStyle}"
                                Width="240" Height="58"
                                Click="PlayButton_Click" />
                    </Grid>
                </Grid>

                <!-- STAGE 2: GRÁFICOS & FLAGS -->
                <Grid x:Name="PanelGraficos" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: Display & Visual Flags -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="EXIBIÇÃO &amp; QUALIDADE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />

                                <CheckBox x:Name="FullscreenCheck" IsChecked="True">
                                    <StackPanel>
                                        <TextBlock Text="Tela Cheia Exclusiva" FontWeight="SemiBold" />
                                        <TextBlock Text="--fullscreen=true (Executa sem bordas ocupando o monitor)" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="FxaaCheck" IsChecked="True">
                                    <StackPanel>
                                        <TextBlock Text="Anti-Aliasing FXAA" FontWeight="SemiBold" />
                                        <TextBlock Text="--mcla_anti_aliasing=fxaa (Suavização pós-processamento)" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="VsyncCheck" IsChecked="False">
                                    <StackPanel>
                                        <TextBlock Text="Sincronização Vertical (V-Sync)" FontWeight="SemiBold" />
                                        <TextBlock Text="--vsync=true (Elimina tearing travando à taxa do monitor)" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="FastShadowsCheck" IsChecked="True">
                                    <StackPanel>
                                        <TextBlock Text="Sombras Rápidas em Veículos" FontWeight="SemiBold" />
                                        <TextBlock Text="--mcla_fast_car_shadows=true (Otimiza renderização de lataria)" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>

                            <!-- Column 2: Engine & System Flags -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MOTOR &amp; SUBSISTEMAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />

                                <CheckBox x:Name="PtBrCheck" IsChecked="True">
                                    <StackPanel>
                                        <TextBlock Text="Tradução em Português (PT-BR)" FontWeight="SemiBold" />
                                        <TextBlock Text="--mcla_ptbr=true (Menus, HUD e legendas em português)" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="IntroCheck" IsChecked="True">
                                    <StackPanel>
                                        <TextBlock Text="Cinemáticas e Vídeos Bink" FontWeight="SemiBold" />
                                        <TextBlock Text="--mcla_intro=normal (Reproduz vídeos com áudio sincronizado)" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="EdramCheck" IsChecked="True">
                                    <StackPanel>
                                        <TextBlock Text="Alocação eDRAM (2048 Tiles)" FontWeight="SemiBold" />
                                        <TextBlock Text="--edram_tiles=2048 (Espaço de buffer gráfico Xenos otimizado)" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox x:Name="FenceCheck" IsChecked="True">
                                    <StackPanel>
                                        <TextBlock Text="Sincronização de GPU Fence" FontWeight="SemiBold" />
                                        <TextBlock Text="--mcla_cache_flush=fence (Evita estolamento de comandos GPU)" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- STAGE 3: INSTALAÇÃO & ISO -->
                <Grid x:Name="PanelInstalacao" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Step 1: ISO File Selection -->
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="1. IMAGEM DO JOGO (XBOX 360 ISO)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                                    <TextBlock Text="Selecione o arquivo .iso original do jogo para extração automática dos arquivos necessários:" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#111216" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <TextBox x:Name="IsoPathBox" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" IsReadOnly="True" Text="(Nenhum arquivo selecionado)" VerticalAlignment="Center" />
                                        </Border>

                                        <Button Grid.Column="1" Content="Procurar ISO..." Margin="10,0,0,0" Padding="16,8" Click="BrowseIso_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Step 2: Extraction -->
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="2. EXTRAÇÃO DOS DADOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                        <Button x:Name="ExtractButton" Content="Extrair Jogo Agora" HorizontalAlignment="Right" Padding="16,6" IsEnabled="False" Click="ExtractButton_Click" />
                                    </Grid>

                                    <ProgressBar x:Name="ExtractProgress" Height="8" Margin="0,0,0,10" Visibility="Collapsed" Background="#1E2028" Foreground="#FFFFFF" />

                                    <TextBox x:Name="ExtractionStatusText"
                                             Background="#0F1014"
                                             Foreground="{StaticResource TextSecondary}"
                                             BorderBrush="{StaticResource BorderMuted}"
                                             BorderThickness="1"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             IsReadOnly="True"
                                             MinHeight="70" MaxHeight="120"
                                             VerticalScrollBarVisibility="Auto"
                                             Padding="10" />
                                </StackPanel>
                            </Border>

                            <!-- Step 3: Shortcuts -->
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ATALHOS DO SISTEMA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Text="Crie ou remova atalhos na Área de Trabalho e no Menu Iniciar." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Criar Atalhos" Margin="0,0,8,0" Click="CreateShortcuts_Click" />
                                        <Button Content="Remover Atalhos" Click="RemoveShortcuts_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- STAGE 4: SOBRE -->
                <Grid x:Name="PanelSobre" Visibility="Collapsed">
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="MIDNIGHT CLUB: LOS ANGELES — RECOMPILED" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                            <TextBlock Text="Reimplementação e porte estático nativo para PC x86_64 / DirectX 12." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" />

                            <TextBlock Text="TECNOLOGIAS UTILIZADAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                            <TextBlock Text="• C++20 / LLVM Clang 18+ nativo" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,3" />
                            <TextBlock Text="• ReXGlue SDK (Tradução e abstração de chamadas do sistema)" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,3" />
                            <TextBlock Text="• DirectX 12 Direct3D Render Target Views (RTV)" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,3" />
                            <TextBlock Text="• Bink Video Runtime (Cutscenes e FMVs)" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,3" />
                            <TextBlock Text="• extract-xiso (Xbox 360 filesystem parsing)" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14" />

